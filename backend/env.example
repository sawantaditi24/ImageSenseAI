# Application
DEBUG=False

# CORS - Comma-separated list of allowed origins (optional)
# Default includes localhost and production URLs
# ALLOWED_ORIGINS=http://localhost:3000,https://imagesenseai-1.onrender.com

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-screenshot-bucket-name

# Database
DATABASE_URL=sqlite:///./screenshot_organizer.db

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-vision-preview

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=screenshot-embeddings

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
MAX_STORAGE_PER_USER=104857600  # 100MB per user
MAX_FILES_PER_USER=1000

# Image Processing
THUMBNAIL_SIZE=200,150
MAX_IMAGE_SIZE=1200,800
IMAGE_QUALITY=85 